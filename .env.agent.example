# Copy to .env.agent on the server running the agent. Use a READ-ONLY ERP user.
# Leave ERP_SOURCE empty to load data from CSV uploads and pushed events only.

ERP_SOURCE=            # sap_b1 | netsuite
SYNC_INTERVAL_MINUTES=60   # 0 = only when you press "Sync now"
SYNC_LOOKBACK_DAYS=180
DEFAULT_LEAD_TIME_DAYS=14  # used for suppliers with no lead-time field configured

# SAP Business One (Service Layer)
SAP_B1_URL=https://sap.example.com:50000/b1s/v1
SAP_B1_COMPANY_DB=
SAP_B1_USERNAME=
SAP_B1_PASSWORD=
SAP_B1_VERIFY_TLS=true
SAP_B1_CA_BUNDLE=          # path to your CA certificate if SAP uses a private CA
SAP_B1_LEAD_TIME_FIELD=    # user-defined field on BusinessPartners, e.g. U_LeadTimeDays
SAP_B1_STRIKE_FIELD=       # optional user-defined supplier-standing field

# NetSuite (SuiteQL, token-based authentication)
NETSUITE_ACCOUNT_ID=       # e.g. 1234567 or 1234567_SB1 for a sandbox
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
# Optional: replace a default query. Column aliases must be the importer's field names.
# NETSUITE_QUERY_SUPPLIERS=
# NETSUITE_QUERY_ITEMS=
# NETSUITE_QUERY_PURCHASE_ORDERS=
# NETSUITE_QUERY_STOCK_LEVELS=
